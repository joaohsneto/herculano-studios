import assert from 'node:assert/strict';
import test from 'node:test';
import { createRequire } from 'node:module';
import express from '../backend/node_modules/express/index.js';
import cookieParser from '../backend/node_modules/cookie-parser/index.js';
import bcrypt from '../backend/node_modules/bcryptjs/index.js';
import type { AddressInfo } from 'node:net';
process.env.DATABASE_URL ||= 'postgresql://test:test@localhost/test';
process.env.JWT_SECRET = 'test-secret-at-least-thirty-two-characters';
process.env.AUTH_SECRET = process.env.JWT_SECRET;
process.env.FRONTEND_URL = 'http://localhost:3000';
const require = createRequire(new URL('../backend/node_modules/@auth/express/index.js', import.meta.url));
const { encode } = await import(require.resolve('@auth/core/jwt'));
const { createProfileRouter } = await import('../backend/src/routes/profile.ts');
const { prisma } = await import('../backend/src/lib/prisma.ts');

test('perfil protegido, dados permitidos e alteração de senha autenticada', async () => {
  const user: any = { id: 'customer-1', name: 'Cliente', email: 'cliente@example.com', phone: null, company: null, role: 'CUSTOMER', passwordHash: await bcrypt.hash('Original1!', 4) };
  let deliveredCode = ''; let failDelivery = false; let configured = true;
  const router = createProfileRouter(async (email, code) => { assert.equal(email, 'new@example.com'); if (failDelivery) throw Error('SMTP failure'); deliveredCode = code; }, () => configured);
  const originals = { find: prisma.user.findUnique, findThrow: prisma.user.findUniqueOrThrow, update: prisma.user.update, updateMany: prisma.user.updateMany };
  let updates = 0;
  prisma.user.findUnique = (async ({ where }: any) => { if (where.email) return where.email === 'taken@example.com' ? { id: 'other-user' } : null; assert.equal(where.id, user.id); return { ...user }; }) as any;
  prisma.user.findUniqueOrThrow = (async () => ({ ...user })) as any;
  prisma.user.update = (async ({ where, data }: any) => { assert.equal(where.id, user.id); updates++; Object.assign(user, data); return { ...user }; }) as any;
  prisma.user.updateMany = (async ({ where, data }: any) => {
    assert.equal(where.id, user.id);
    if (where.passwordHash && where.passwordHash !== user.passwordHash) return { count: 0 };
    if (where.emailChangeHash && where.emailChangeHash !== user.emailChangeHash) return { count: 0 };
    if (where.emailChangeAttempts && user.emailChangeAttempts >= where.emailChangeAttempts.lt) return { count: 0 };
    if (data.email === 'taken@example.com') throw Object.assign(Error('conflict'), { code: 'P2002' });
    if (data.emailChangeAttempts?.increment) { user.emailChangeAttempts += data.emailChangeAttempts.increment; } else Object.assign(user, data);
    return { count: 1 };
  }) as any;
  const app = express(); app.use(express.json()); app.use(cookieParser()); app.use('/api/account/profile', router);
  const server = app.listen(0, '127.0.0.1'); await new Promise<void>(resolve => server.once('listening', resolve));
  const url = `http://127.0.0.1:${(server.address() as AddressInfo).port}/api/account/profile`;
  const token = await encode({ token: { sub: user.id }, secret: process.env.AUTH_SECRET!, salt: 'authjs.session-token' });
  const headers = { cookie: `authjs.session-token=${token}`, origin: process.env.FRONTEND_URL!, 'Content-Type': 'application/json' };
  const send = (path: string, body: unknown, method = 'POST', extra = {}) => fetch(url + path, { method, headers: { ...headers, ...extra }, body: JSON.stringify(body) });
  try {
    assert.equal((await fetch(url)).status, 401);
    const profile = await (await fetch(url, { headers })).json();
    assert.equal(profile.user.hasPassword, true); assert.equal(profile.user.passwordHash, undefined);
    const data = { name: 'Cliente Atualizado', phone: '(82) 99999-9999', company: 'Studio' };
    assert.equal((await send('', data, 'PATCH', { origin: 'https://other.example' })).status, 403);
    for (const invalid of [{ ...data, role: 'ADMIN' }, { ...data, email: 'other@example.com' }, { ...data, phone: 'abc' }]) assert.equal((await send('', invalid, 'PATCH')).status, 400);
    assert.equal(updates, 0);
    assert.equal((await send('', data, 'PATCH')).status, 200); assert.equal(user.name, data.name);
    assert.equal((await send('', { ...data, phone: '', company: '' }, 'PATCH')).status, 200); assert.equal(user.phone, null); assert.equal(user.company, null);
    assert.equal((await send('/password', { currentPassword: 'Wrong1!', newPassword: 'Updated1!' })).status, 400);
    assert.equal((await send('/password', { currentPassword: 'Original1!', newPassword: 'weak' })).status, 400);
    assert.equal((await send('/password', { currentPassword: 'Original1!', newPassword: 'Updated1!' })).status, 200);
    assert.equal(await bcrypt.compare('Updated1!', user.passwordHash), true);
    assert.equal((await send('/password', { currentPassword: 'Original1!', newPassword: 'Another1!' })).status, 400);
    const emailRequest = { email: 'new@example.com', currentPassword: 'Updated1!' };
    assert.equal((await send('/email', { ...emailRequest, currentPassword: 'Wrong1!' })).status, 400);
    assert.equal((await send('/email', { ...emailRequest, email: 'taken@example.com' })).status, 409);
    configured = false; assert.equal((await send('/email', emailRequest)).status, 503); configured = true;
    failDelivery = true; assert.equal((await send('/email', emailRequest)).status, 503); assert.equal(user.emailChangeHash, null); failDelivery = false;
    assert.equal((await send('/email', emailRequest)).status, 200);
    assert.equal(user.email, 'cliente@example.com'); assert.match(deliveredCode, /^[0-9]{6}$/); assert.notEqual(user.emailChangeHash, deliveredCode);
    assert.equal((await send('/email', emailRequest)).status, 429);
    assert.equal((await send('/email/confirm', { code: '000000' })).status, 400); assert.equal(user.emailChangeAttempts, 1);
    assert.equal((await send('/email/confirm', { code: deliveredCode })).status, 200); assert.equal(user.email, 'new@example.com'); assert.equal(user.emailChangeHash, null);
    assert.equal((await send('/email/confirm', { code: deliveredCode })).status, 400);
    user.email = 'cliente@example.com';
    user.emailChangeExpiresAt = null;
    assert.equal((await send('/email', emailRequest)).status, 200);
    user.emailChangeExpiresAt = new Date(Date.now() - 1);
    assert.equal((await send('/email/confirm', { code: deliveredCode })).status, 400);
    user.emailChangeExpiresAt = new Date(Date.now() + 60_000); user.emailChangeAttempts = 5;
    assert.equal((await send('/email/confirm', { code: deliveredCode })).status, 400);
    user.googleId = 'google-id'; user.emailChangeExpiresAt = null;
    assert.equal((await send('/email', emailRequest)).status, 400); user.googleId = null;
    (user as any).passwordHash = null;
    assert.equal((await send('/password', { currentPassword: 'Updated1!', newPassword: 'Another1!' })).status, 400);
    assert.equal((await (await fetch(url, { headers })).json()).user.hasPassword, false);
  } finally {
    prisma.user.findUnique = originals.find; prisma.user.findUniqueOrThrow = originals.findThrow; prisma.user.update = originals.update; prisma.user.updateMany = originals.updateMany;
    await new Promise<void>(resolve => server.close(() => resolve())); await prisma.$disconnect();
  }
});
