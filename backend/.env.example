NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/herculano_studios?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
PRIVATE_STORAGE_PATH=./storage/private
PREVIEW_STORAGE_PATH=./storage/previews
ADMIN_NAME=João Victor Herculano Perciano
ADMIN_EMAIL=joaovictorhp06@gmail.com
ADMIN_PASSWORD=define-locally-do-not-commit
# Auth.js uses JWT_SECRET above as its secret (AUTH_SECRET can override it).
# Google OAuth web client. Callback: FRONTEND_URL + /api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=herculanostudios@gmail.com
# Google app password, never the normal account password.
SMTP_PASS=
SMTP_FROM=herculanostudios@gmail.com
